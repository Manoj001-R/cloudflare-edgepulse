# ========================================================
# EdgePulse Backend Configuration
# ========================================================

# Application
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8787

# Demo Mode (Simulates tools & LLM for deterministic offline execution)
DEMO_MODE=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./edgepulse.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/edgepulse

# LLM Provider: 'openai' | 'cloudflare' | 'custom'
LLM_PROVIDER=openai

# OpenAI / OpenAI-compatible configuration
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Cloudflare Workers AI configuration (optional if using cloudflare provider)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Latency Thresholds (Milliseconds)
LATENCY_LOW_THRESHOLD_MS=300
LATENCY_MODERATE_THRESHOLD_MS=1000
LATENCY_HIGH_THRESHOLD_MS=2000

# Rate Limiting
RATE_LIMIT_INCIDENT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_TOOLS_PER_MINUTE=40

# Network & SSRF Safety
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=2097152
MAX_REDIRECTS=5
ALLOWED_PORTS=80,443

{
  "name": "edgepulse",
  "version": "1.0.0",
  "private": true,
  "description": "EdgePulse — AI Internet Incident Investigator powered by Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build && wrangler deploy --dry-run",
    "build:frontend": "vite build",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.10.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.3",
    "vitest": "^2.0.5",
    "wrangler": "^3.78.0"
  }
}
